# Usuario habilitado para pruebas.
USER_TEST_DEVICE=99999
# Habilita el acceso directo del dispositivo de pruebas de google en aplicaciones de mobiles.
USER_TEST_ACCESS=false

# Secreto para crear y verificar el JWT BCB
BCB_JWT_PRIVATE_KEY=""
BCB_JWT_PUBLIC_KEY=""

# Web OIDC is optional. Set WEB_AUTH_ENABLED=true in the parent environment to enable it.
OIDC_ISSUER=http://localhost:8080/realms/muserpol
OIDC_INTERNAL_BASE_URL=http://keycloak:8080
OIDC_HUB_TOOL_KEY=hub
OIDC_HUB_CLIENT_ID=hub-client-example
OIDC_HUB_CLIENT_TYPE=public
OIDC_HUB_CLIENT_SECRET=
OIDC_HUB_CALLBACK_URL=http://localhost:3000/auth/callback
OIDC_HUB_POST_LOGOUT_REDIRECT_URL=http://localhost:3000/
# Administratively controlled JSON keyed by a lowercase tool key; repeated JSON keys keep the last value.
# It contains technical identifiers only and no secrets.
WEB_CLIENT_CATALOG={"beneficiary":{"clientId":"beneficiary-interface"},"sales":{"clientId":"sales-interface"}}
WEB_REDIS_HOST=redis
WEB_REDIS_PORT=6379
# WEB_REDIS_PASSWORD comes from the parent .env file.
WEB_PENDING_TTL_SECONDS=600
WEB_SESSION_TTL_SECONDS=28800
WEB_SESSION_IDLE_TTL_SECONDS=7200
WEB_REFRESH_SKEW_SECONDS=120
WEB_REDIS_KEY_PREFIX=muserpol-web
