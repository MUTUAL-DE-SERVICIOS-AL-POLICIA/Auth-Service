# Usuario habilitado para pruebas.
USER_TEST_DEVICE=99999
# Habilita el acceso directo del dispositivo de pruebas de google en aplicaciones de mobiles.
USER_TEST_ACCESS=false

# Secreto para crear y verificar el JWT BCB
BCB_JWT_PRIVATE_KEY=""
BCB_JWT_PUBLIC_KEY=""

# OIDC web se habilita con WEB_AUTH_ENABLED=true en el entorno padre.
OIDC_ISSUER=http://localhost:8080/realms/muserpol
OIDC_INTERNAL_BASE_URL=http://keycloak:8080
# El Hub es siempre un cliente confidencial; el secreto es obligatorio.
OIDC_HUB_CLIENT_SECRET=
OIDC_HUB_CALLBACK_URL=http://localhost:3001/api/auth/callback
OIDC_HUB_POST_LOGOUT_REDIRECT_URL=http://localhost:3001/
# JSON administrado, indexado por una clave de herramienta en minúsculas.
# Contiene únicamente identificadores técnicos y no contiene secretos.
WEB_CLIENT_CATALOG={"beneficiary":{"clientId":"beneficiary-interface"},"sales":{"clientId":"sales-interface"},"collections":{"clientId":"collections-interface"}}

# Contraseña compartida por Auth-Service y el contenedor Redis.
WEB_REDIS_PASSWORD=

# Overrides opcionales. Si se omiten se usan los valores documentados.
# OIDC_HUB_TOOL_KEY=hub
# OIDC_HUB_CLIENT_ID=hub-interface
# WEB_REDIS_HOST=redis
# WEB_REDIS_PORT=6379
# WEB_REDIS_KEY_PREFIX=muserpol-web
# WEB_PENDING_TTL_SECONDS=600
# WEB_SESSION_TTL_SECONDS=28800
# WEB_SESSION_IDLE_TTL_SECONDS=7200
# WEB_REFRESH_SKEW_SECONDS=120

# Conexión de Keycloak con PostgreSQL.
KC_DB_URL_HOST=
KC_DB_URL_DATABASE=
KC_DB_USERNAME=
KC_DB_PASSWORD=
# Keycloak usa puerto 5432 y schema keycloak. Para cambiarlos, habilitar:
# KC_DB_URL_PORT=5432
# KC_DB_SCHEMA=keycloak

# Salud, hostname y opciones de proxy de Keycloak.
KC_HOSTNAME=http://localhost:8080

# Credenciales usadas solamente para crear el administrador inicial.
KC_BOOTSTRAP_ADMIN_USER=
KC_BOOTSTRAP_ADMIN_PASSWORD=
