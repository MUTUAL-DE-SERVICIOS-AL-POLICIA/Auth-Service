# Usuario habilitado para pruebas.
USER_TEST_DEVICE=99999
# Habilita el acceso directo del dispositivo de pruebas de google en aplicaciones de mobiles.
USER_TEST_ACCESS=false

# Secreto para crear y verificar el JWT BCB
BCB_JWT_PRIVATE_KEY=""
BCB_JWT_PUBLIC_KEY=""

# Compatibilidad exclusiva con la importación de documentos de PVT-BE.
# En dev, el flujo heredado conserva su comportamiento y no valida la contraseña.
LDAP_HOST=localhost
LDAP_PORT=389
LDAP_ADMIN_PREFIX=cn
LDAP_ADMIN_USERNAME=admin
LDAP_ADMIN_PASSWORD=
LDAP_BASEDN="dc=muserpol,dc=gob,dc=bo"
# Firma de los tokens heredados y clave compartida entre PVT-BE y Gateway.
JWT_SECRET=
API_KEY=

# OIDC web se habilita con WEB_AUTH_ENABLED=true en el entorno padre.
# Produccion exige HTTPS. Habilitar solamente en una red institucional HTTP
# cuyo riesgo haya sido aceptado expresamente.
# WEB_AUTH_ALLOW_INSECURE_HTTP=false
# Origen público compartido por Keycloak y el Hub, sin puerto ni ruta.
# Auth-Service deriva el issuer, callback y retorno de logout desde este valor.
AUTH_PUBLIC_ORIGIN=http://localhost
OIDC_INTERNAL_BASE_URL=http://keycloak:8080
# El Hub es siempre un cliente confidencial; el secreto es obligatorio.
OIDC_HUB_CLIENT_SECRET=
# Las claves de este catálogo deben coincidir con AUTH_TOOL_KEY en cada frontend.
# Los valores son identificadores técnicos y no contienen secretos.
AUTH_TOOL_CLIENTS={"beneficiary":{"clientId":"beneficiary-interface"},"sales":{"clientId":"sales-interface"},"collections":{"clientId":"collections-interface"}}

# Contraseña compartida por Auth-Service y el contenedor Redis.
WEB_REDIS_PASSWORD=

# Overrides opcionales. Si se omiten se usan los valores documentados.
# OIDC_HUB_TOOL_KEY=hub
# OIDC_HUB_CLIENT_ID=hub-interface
# AUTH_HUB_PORT=3001
# CALLBACK_PATH=/api/auth/callback
# WEB_REDIS_HOST=redis
# WEB_REDIS_PORT=6379
# WEB_REDIS_KEY_PREFIX=muserpol-web
# WEB_PENDING_TTL_SECONDS=600
# WEB_SESSION_TTL_SECONDS=28800
# WEB_SESSION_IDLE_TTL_SECONDS=7200
# WEB_REFRESH_SKEW_SECONDS=120

# Keycloak usa la conexión DB_* del launcher y almacena sus tablas en este schema.
KC_DB_SCHEMA=keycloak

# Salud, hostname y opciones de proxy de Keycloak.
# Por defecto se deriva de AUTH_PUBLIC_ORIGIN y KEYCLOAK_PORT. Definir este
# override únicamente si Keycloak se publica mediante otra URL o proxy.
# KC_HOSTNAME=http://localhost:8080

# Enlace HTTPS al manual de usuario mostrado en todas las ayudas del tema de
# Keycloak. Si queda vacío, los enlaces de ayuda no se muestran.
KEYCLOAK_USER_MANUAL_URL=

# Credenciales usadas solamente para crear el administrador inicial.
KC_BOOTSTRAP_ADMIN_USER=
KC_BOOTSTRAP_ADMIN_PASSWORD=
