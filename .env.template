# Configuración para ejecución independiente de Auth-Service.
# Para Docker Compose, usar preferentemente .env.compose.template junto con
# .env.template del launcher padre.

# Transporte NATS.
NATS_SERVERS="nats://localhost:4222"

# Ambiente de ejecución: dev o prod.
ENVIRONMENT=dev

# Soporte para el dispositivo de pruebas de App Mobile.
# Debe permanecer deshabilitado fuera de su caso de prueba explícito.
USER_TEST_DEVICE=99999
USER_TEST_ACCESS=false

# Claves para firma y verificación de BCB.
# Los valores PEM reales deben almacenarse fuera de Git.
BCB_JWT_PRIVATE_KEY=""
BCB_JWT_PUBLIC_KEY=""

# Compatibilidad exclusiva con la importación de documentos de PVT-BE.
LDAP_HOST=localhost
LDAP_PORT=389
LDAP_ADMIN_PREFIX=cn
LDAP_ADMIN_USERNAME=admin
LDAP_ADMIN_PASSWORD=
LDAP_BASEDN="dc=muserpol,dc=gob,dc=bo"
JWT_SECRET=
API_KEY=

# La autenticación web puede deshabilitarse cuando su infraestructura no exista.
WEB_AUTH_ENABLED=false

# Origen público compartido por Keycloak y el Hub, sin puerto ni ruta.
AUTH_PUBLIC_ORIGIN=http://localhost
# Origen interno usado por Auth-Service para comunicarse con Keycloak.
OIDC_INTERNAL_BASE_URL=http://localhost:8080

# Cliente OIDC del Hub. El secreto solo se usa cuando el cliente tiene tipo confidential.
OIDC_HUB_TOOL_KEY=hub
OIDC_HUB_CLIENT_ID=hub-interface
OIDC_HUB_CLIENT_SECRET=
# Las claves deben coincidir con AUTH_TOOL_KEY en cada frontend.
AUTH_TOOL_CLIENTS={"beneficiary":{"clientId":"beneficiary-interface"},"sales":{"clientId":"sales-interface"},"collections":{"clientId":"collections-interface"}}

# Valores usados para derivar issuer, callback y retorno tras logout.
KEYCLOAK_PORT=8080
AUTH_HUB_PORT=3001
CALLBACK_PATH=/api/auth/callback

# Sesiones web almacenadas en Redis.
WEB_REDIS_HOST=localhost
WEB_REDIS_PORT=6379
WEB_REDIS_PASSWORD=
WEB_REDIS_KEY_PREFIX=muserpol-web
WEB_PENDING_TTL_SECONDS=600
WEB_SESSION_TTL_SECONDS=28800
WEB_SESSION_IDLE_TTL_SECONDS=7200
WEB_REFRESH_SKEW_SECONDS=120
